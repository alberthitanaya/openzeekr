     release app on the launcher, app switcher and settings. (Package suffix lives in build.gradle.kts.) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="OpenZeekr Dev"
        tools:replace="android:label">
        <activity
            android:name=".MainActivity"
            android:label="OpenZeekr Dev"
            tools:replace="android:label" />
    </application>
</manifest>
